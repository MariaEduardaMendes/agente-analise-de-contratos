{
  "$schema": "https://json.schemastore.org/claude-settings.json",
  "description": "Especificação formal de permissões e governança para o Agente 1 (Extrator Enriquecido de Contratos)",
  "permissions": {
    "allow": [
      "FileRead(*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(python test_api.py*)",
      "Bash(python agente_extracao.py*)",
      "Bash(python demo_memoria_rag.py*)",
      "Bash(python pipeline_raciocinio.py*)"
    ],
    "deny": [
      "FileWrite(../agent2/*)",
      "FileEdit(../agent2/*)",
      "Bash(*agent2*)",
      "FileWrite(.env*)",
      "FileEdit(.env*)",
      "FileDelete(.env*)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(*DROP TABLE*)"
    ],
    "ask": [
      "FileWrite(models.py)",
      "FileEdit(models.py)",
      "FileWrite(memoria_rag.py)",
      "FileEdit(memoria_rag.py)",
      "Bash(pip install*)",
      "Bash(git push*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "FileWrite|FileEdit|Bash",
        "command": "python .claude/hooks/pre_tool_use.py"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "FileWrite|FileEdit",
        "command": "python .claude/hooks/post_tool_use.py"
      }
    ]
  }
}
