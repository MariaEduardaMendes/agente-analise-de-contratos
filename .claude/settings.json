{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Read(.env*)",
      "Edit(.env*)",
      "Write(.env*)",
      "Bash(rm -rf *)",
      "Bash(del /f /q *)",
      "Bash(git push --force*)",
      "Bash(*DROP TABLE*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(pip install*)"
    ]
  }
}
