{
  "id": "IT2Helo3G5z3dBTE",
  "name": "Sub-workflow: Polling Assincrono Resiliente de Tarefas",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        220
      ],
      "id": "node-sub-trigger",
      "name": "Trigger de Execução (Sub-workflow)"
    },
    {
      "parameters": {
        "jsCode": "// Inicializa os parâmetros de sondagem com contador zerado.\n// Quando executado isoladamente no editor n8n (sem input do workflow pai),\n// gera um task_id de demonstração autônomo ('demo-subworkflow-<timestamp>')\n// que dispara e monitora uma tarefa assíncrona real no Agente 1.\nconst entrada = $json || {};\nconst taskId = entrada.task_id || `demo-subworkflow-${Date.now()}`;\nreturn [{\n  json: {\n    endpoint_status: entrada.endpoint_status || \"http://127.0.0.1:8001/status/\",\n    task_id: taskId,\n    intervalo_segundos: Number(entrada.intervalo_segundos || 2),\n    tentativa_atual: 0,\n    max_tentativas: Number(entrada.max_tentativas || 30),\n    modo_execucao: entrada.task_id ? \"subworkflow_chamado\" : \"teste_isolado_autonomo\"\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        220
      ],
      "id": "node-sub-init",
      "name": "Inicializar Contador de Polling"
    },
    {
      "parameters": {
        "jsCode": "// Incrementa tentativa preservando todo o estado do polling no fluxo\nconst atual = $json;\nreturn [{\n  json: {\n    endpoint_status: atual.endpoint_status,\n    task_id: atual.task_id,\n    intervalo_segundos: atual.intervalo_segundos,\n    tentativa_atual: Number(atual.tentativa_atual || 0) + 1,\n    max_tentativas: atual.max_tentativas\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        220
      ],
      "id": "node-sub-incrementar",
      "name": "Incrementar Tentativa"
    },
    {
      "parameters": {
        "amount": "={{ $json.intervalo_segundos }}",
        "unit": "seconds"
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        660,
        220
      ],
      "id": "node-sub-wait",
      "name": "Aguardar Intervalo (Wait)"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.endpoint_status }}{{ $json.task_id }}",
        "options": {
          "timeout": 30000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        220
      ],
      "id": "node-sub-http-status",
      "name": "Consultar Status HTTP GET"
    },
    {
      "parameters": {
        "jsCode": "// Preserva o estado de controle do polling junto à resposta HTTP da iteração atual\nconst estado = $('Incrementar Tentativa').last().json;\nconst respostaHttp = $json;\nreturn [{\n  json: {\n    endpoint_status: estado.endpoint_status,\n    task_id: respostaHttp.task_id || estado.task_id,\n    intervalo_segundos: estado.intervalo_segundos,\n    tentativa_atual: estado.tentativa_atual,\n    max_tentativas: estado.max_tentativas,\n    status: respostaHttp.status,\n    created_at: respostaHttp.created_at ?? null,\n    completed_at: respostaHttp.completed_at ?? null,\n    data: respostaHttp.data ?? null,\n    error: respostaHttp.error ?? null\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        220
      ],
      "id": "node-sub-merge-state",
      "name": "Consolidar Estado do Polling"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-status-done",
              "leftValue": "={{ $json.status }}",
              "rightValue": "done",
              "operator": {
                "type": "string",
                "operation": "equals",
                "name": "filter.operator.equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1320,
        220
      ],
      "id": "node-sub-if-done",
      "name": "Tarefa Finalizada (Status Done)?"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-status-error",
              "leftValue": "={{ $json.status }}",
              "rightValue": "error",
              "operator": {
                "type": "string",
                "operation": "equals",
                "name": "filter.operator.equals"
              }
            },
            {
              "id": "cond-tentativas-esgotadas",
              "leftValue": "={{ $json.tentativa_atual }}",
              "rightValue": "={{ $json.max_tentativas }}",
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1540,
        360
      ],
      "id": "node-sub-if-limite",
      "name": "Erro ou Tentativas Esgotadas?"
    },
    {
      "parameters": {
        "jsCode": "// Erro de execução do agente ou timeout do polling\nconst item = $json;\nconst isAgentError = item.status === 'error';\nreturn [{\n  json: {\n    sucesso: false,\n    task_id: item.task_id,\n    status: \"error\",\n    tentativas_realizadas: item.tentativa_atual,\n    motivo: isAgentError ? \"ERRO_EXECUCAO_AGENTE\" : \"TIMEOUT_POLLING_EXCEDIDO\",\n    mensagem: isAgentError\n      ? `A tarefa ${item.task_id} falhou no agente: ${item.error || 'erro desconhecido'}`\n      : `A tarefa ${item.task_id} não concluiu dentro de ${item.max_tentativas} tentativas.`\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        300
      ],
      "id": "node-sub-timeout-erro",
      "name": "Retorno de Erro ou Timeout"
    },
    {
      "parameters": {
        "jsCode": "// Retorno padronizado de sucesso do sub-workflow\nconst resultado = $json;\nreturn [{\n  json: {\n    sucesso: true,\n    task_id: resultado.task_id,\n    status: resultado.status,\n    tentativas_realizadas: resultado.tentativa_atual,\n    created_at: resultado.created_at,\n    completed_at: resultado.completed_at,\n    data: resultado.data\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        120
      ],
      "id": "node-sub-retorno-sucesso",
      "name": "Retorno Formatado com Sucesso"
    }
  ],
  "pinData": {},
