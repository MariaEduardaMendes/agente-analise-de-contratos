        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2080,
        180
      ],
      "id": "node-agente2-get-status",
      "name": "Agente 2: Consultar GET /status"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-agente2-done",
              "leftValue": "={{ $json.status }}",
              "rightValue": "done",
              "operator": {
                "type": "string",
                "operation": "equals",
                "name": "filter.operator.equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2300,
        180
      ],
      "id": "node-agente2-if-done",
      "name": "Agente 2 Concluído?"
    },
    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByPosition",
        "options": {}
      },
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        2560,
        260
      ],
      "id": "node-merge-agentes",
      "name": "Merge Agente 1 e Agente 2"
    },
    {
      "parameters": {
        "jsCode": "// Consolida o Dossiê Final de Análise Contratual a partir dos outputs dos Agentes 1 e 2\nconst resultadoAgente1 = $('Agente 1: Consultar GET /status').item.json;\nconst resultadoAgente2 = $('Agente 2: Consultar GET /status').item.json;\n\nconst extracao = resultadoAgente1.data || {};\nconst auditoria = resultadoAgente2.data || {};\n\n// Determina a recomendação executiva de governança\nlet decisaoGovernança = \"APROVADO_DIRETORIA\";\nif (auditoria.nivel_risco_geral === \"ALTO\" || (auditoria.itens_nao_conformes && auditoria.itens_nao_conformes > 0)) {\n  decisaoGovernança = \"BLOQUEADO_REVISAO_JURIDICA_OBRIGATORIA\";\n} else if (auditoria.nivel_risco_geral === \"BAIXO\") {\n  decisaoGovernança = \"APROVADO_SUMARIAMENTE\";\n}\n\nreturn [{\n  json: {\n    metadata_pipeline: {\n      orquestrador: \"n8n Workflow Engine v1.x/v2.x\",\n      ciclo: \"Assíncrono Completo com Polling e Roteamento de Risco\",\n      timestamp_conclusao: new Date().toISOString(),\n      agente_extracao: {\n        task_id: resultadoAgente1.task_id,\n        status: resultadoAgente1.status,\n        tempo_execucao_s: resultadoAgente1.completed_at ? (resultadoAgente1.completed_at - resultadoAgente1.created_at).toFixed(2) : null\n      },\n      agente_auditoria: {\n        task_id: resultadoAgente2.task_id,\n        status: resultadoAgente2.status,\n        tempo_execucao_s: resultadoAgente2.completed_at ? (resultadoAgente2.completed_at - resultadoAgente2.created_at).toFixed(2) : null\n      }\n    },\n    contrato: {\n      titulo: extracao.titulo,\n      partes: {\n        contratante: extracao.contratante,\n        contratada: extracao.contratada\n      },\n      objeto: extracao.objeto,\n      financeiro: extracao.financeiro,\n      vigencia: extracao.vigencia,\n      penalidades: extracao.penalidades,\n      fornecedor_homologado: extracao.fornecedor_homologado\n    },\n    auditoria_conformidade: {\n      score_conformidade: auditoria.score_conformidade,\n      nivel_risco_geral: auditoria.nivel_risco_geral,\n      itens_auditados: auditoria.itens_auditados,\n      total_regras_auditadas: auditoria.total_regras_auditadas,\n      itens_conformes: auditoria.itens_conformes,\n      itens_alerta: auditoria.itens_alerta,\n      itens_nao_conformes: auditoria.itens_nao_conformes,\n      recomendacoes_mitigacao: auditoria.recomendacoes_mitigacao,\n      parecer_executivo_markdown: auditoria.parecer_executivo_markdown\n    },\n    decisao_governanca: decisaoGovernança\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2800,
        260
      ],
      "id": "node-consolidar-dossie",
      "name": "Consolidar Dossiê Contratual Final"
    }
  ],
