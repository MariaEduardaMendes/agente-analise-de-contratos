{
  "name": "TP4 - Orquestrador n8n Assincrono com Polling e Roteamento",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "id": "node-trigger-manual",
      "name": "Disparo Manual (Input Contrato)"
    },
    {
      "parameters": {
        "jsCode": "// Define o contrato de entrada e parâmetros do pipeline\nreturn [{\n  json: {\n    contrato_id: \"CTR-2026-N8N-001\",\n    solicitante: \"Auditoria e Governança Corporativa\",\n    texto_contrato: `CONTRATO DE PRESTAÇÃO DE SERVIÇOS DE DESENVOLVIMENTO DE INTELIGÊNCIA ARTIFICIAL\\n\\nCONTRATANTE: TechSolutions Ltda., inscrita no CNPJ sob o nº 12.345.678/0001-90, com sede na Av. Paulista, 1000, São Paulo/SP.\\n\\nCONTRATADA: Alfa Consultoria em IA S.A., inscrita no CNPJ sob o nº 98.765.432/0001-10, com sede no Rio de Janeiro/RJ.\\n\\nCLÁUSULA PRIMEIRA - DO OBJETO\\nO presente instrumento tem por objeto a prestação de serviços técnicos especializados de desenvolvimento, integração e suporte de agentes inteligentes autônomos para análise contratual.\\n\\nCLÁUSULA SEGUNDA - DO VALOR E FORMA DE PAGAMENTO\\nPela prestação dos serviços, a CONTRATANTE pagará à CONTRATADA o valor global de R$ 120.000,00 (cento e vinte mil reais), dividido em 12 (doze) parcelas mensais e sucessivas de R$ 10.000,00 (dez mil reais).\\n\\nCLÁUSULA TERCEIRA - DA VIGÊNCIA\\nO prazo de vigência deste contrato é de 12 (doze) meses, iniciando-se em 15 de janeiro de 2026 e encerrando-se em 15 de janeiro de 2027. O contrato poderá ser rescindido antecipadamente mediante aviso prévio por escrito de 30 (trinta) dias.\\n\\nCLÁUSULA QUARTA - DA RESCISÃO E MULTA\\nEm caso de rescisão imotivada por iniciativa de qualquer das partes antes do término do prazo estipulado, a parte que der causa incorrerá em multa compensatória de 20% (vinte por cento) sobre o saldo remanescente do contrato.`\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "id": "node-preparar-dados-entrada",
      "name": "Preparar Minuta Contratual"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8001/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"texto_contrato\": {{ JSON.stringify($json.texto_contrato) }}\n}",
        "options": {
          "timeout": 30000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ],
      "id": "node-agente1-post-run",
      "name": "Agente 1: Submeter POST /run"
    },
    {
      "parameters": {
        "amount": 2,
        "unit": "seconds"
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        700,
        300
      ],
      "id": "node-agente1-wait",
      "name": "Wait (Polling Agente 1)"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://127.0.0.1:8001/status/{{ $('Agente 1: Submeter POST /run').item.json.task_id }}",
        "options": {
          "timeout": 30000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        300
      ],
      "id": "node-agente1-get-status",
      "name": "Agente 1: Consultar GET /status"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-agente1-done",
              "leftValue": "={{ $json.status }}",
              "rightValue": "done",
              "operator": {
                "type": "string",
                "operation": "equals",
                "name": "filter.operator.equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1140,
        300
      ],
      "id": "node-agente1-if-done",
      "name": "Agente 1 Concluído?"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-roteamento-valido",
              "leftValue": "={{ $json.data.financeiro.valor_total_brl }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1380,
        220
      ],
      "id": "node-roteador-decisao",
      "name": "Roteador: Dados Válidos para Auditoria?"
    },
    {
      "parameters": {
        "jsCode": "// Extração incompleta ou inválida: gera log de exceção sem acionar Agente 2\nreturn [{\n  json: {\n    status_pipeline: \"BLOQUEADO_EXTRACAO_INVALIDA\",\n    motivo: \"Contrato não possui valor financeiro calculável ou cláusulas mínimas extraídas.\",\n    dados_parciais: $json\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1620,
        420
      ],
      "id": "node-excecao-extracao",
      "name": "Tratamento de Exceção Contratual"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8002/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"dados_contrato\": {{ JSON.stringify($json.data) }}\n}",
        "options": {
          "timeout": 30000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1620,
        180
      ],
      "id": "node-agente2-post-run",
      "name": "Agente 2: Submeter POST /run"
